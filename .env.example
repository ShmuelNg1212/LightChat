# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- BUILD LLM Proxy keys (from Joe's email). Leave blank to hide that interface's model.
BUILD_OPENAI_KEY=
BUILD_ANTHROPIC_KEY=
BUILD_GOOGLE_KEY=
# Optional override of the proxy address.
# PROXY_BASE_URL=https://proxy.litechat.ai

# --- Django
# DEBUG=True enables a fixed development SECRET_KEY. Production: DEBUG=False and set SECRET_KEY.
DEBUG=True
# SECRET_KEY=
# ALLOWED_HOSTS=localhost,127.0.0.1
# Defaults to SQLite (db.sqlite3). For PostgreSQL: postgres://user:pass@host:5432/dbname
# DATABASE_URL=
# LOG_LEVEL=INFO
