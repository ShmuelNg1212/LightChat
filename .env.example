# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- BUILD LLM Proxy keys (from Joe's email). Leave blank to hide that interface's model.
BUILD_OPENAI_KEY=
BUILD_ANTHROPIC_KEY=
BUILD_GOOGLE_KEY=
# Optional override of the proxy address.
# PROXY_BASE_URL=https://proxy.litechat.ai

# --- Django
# DEBUG=True enables a fixed development SECRET_KEY. Production: DEBUG=False and set SECRET_KEY.
DEBUG=True
# SECRET_KEY=
# ALLOWED_HOSTS=localhost,127.0.0.1
# Defaults to SQLite (db.sqlite3). For PostgreSQL: postgres://user:pass@host:5432/dbname
# On Vercel, the Neon integration sets DATABASE_URL (pooled, used at runtime) and
# DATABASE_URL_UNPOOLED (direct, used by migrations in the build). Required there.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# Seconds to keep a database connection open (default 60). Vercel: 0.
# DB_CONN_MAX_AGE=60
# LOG_LEVEL=INFO

# --- Deployment
# HTTPS-only settings (Secure cookies, HSTS, SSL redirect). Defaults to on when VERCEL is set.
# HTTPS_ONLY=False
# Longest a reply may stream, and longest wait between chunks (seconds). Defaults 1200 and 90.
# On Vercel Hobby their sum must stay under 300 (the function limit): use 260 and 25.
# REPLY_MAX_SECONDS=1200
# REPLY_CHUNK_TIMEOUT_SECONDS=90
