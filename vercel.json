{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "django",
  "regions": [
    "fra1"
  ],
  "buildCommand": "DATABASE_URL=\"${DATABASE_URL_UNPOOLED:-$DATABASE_URL}\" python manage.py migrate --noinput",
  "functions": {
    "config/wsgi.py": {
      "maxDuration": 300
    }
  },
  "git": {
    "deploymentEnabled": false
  }
}
